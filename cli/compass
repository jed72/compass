# Declared literally here as well as in compass_pkg.core: this file is
# what `compass --version` and the release-consistency test read, and a
# grep for the constant should find it at the CLI's front door. The
# assert makes the duplication impossible to drift.
COMPASS_VERSION = "3.3.0"
assert COMPASS_VERSION == _core.COMPASS_VERSION, (
    "cli/compass and compass_pkg/core.py disagree about the version")


def _pyyaml_resolution_line():
    """One line for `--version`: which PyYAML this process is actually
    running, and where it came from. This is how a reader checks TRC-G1's
    claim for themselves - "the bundled copy wins" is a sentence until
    someone can ask the running CLI which one it picked (Q11's "how does a
    user find out which version they have")."""
    try:
        return f"PyYAML {yaml.__version__} at {os.path.abspath(yaml.__file__)}"
    except Exception:
        return "PyYAML: unresolved"



