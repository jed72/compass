# --- command: rework-scan ---------------------------------------------------
# Cross-task rework scanner (R4). Reads every task.yml under --root (default:
# .compass/work/) and detects add-then-delete patterns within the configured
# window. Output is Markdown (default) or JSON (--format json). This is a
# SIGNAL, not a gate - exit code is always 0 unless the scan itself errors.
# Patterns are loaded from governance/signals.yml at runtime, never hardcoded.
# Suitable for piping into .compass/flow/rework-<date>.md.
#
# Detection modes:
#   1. Simple add-then-delete: file added by task A, deleted by task B within
#      window_days.
#   2. Public-surface churn: the path matches a public_surface_patterns regex
#      AND the same file is added then deleted.
#   3. Migration pair: a file matching migration_paths (glob) is added in task
#      A, and a semantically paired drop migration is added in task B within
#      window_days.
#
# Architectural invariant: Inv-4 (Flow advises, never gates). This command is
# read-only over the task directory tree; it writes nothing.

import fnmatch
import re as _re

from compass_pkg import core as _core  # noqa: F401
from compass_pkg._all import *  # noqa: F401,F403

# Declared literally here as well as in compass_pkg.core: this file is
# what `compass --version` and the release-consistency test read, and a
# grep for the constant should find it at the CLI's front door. The
# assert makes the duplication impossible to drift.
COMPASS_VERSION = "1.8.0"
assert COMPASS_VERSION == _core.COMPASS_VERSION, (
    "cli/compass and compass_pkg/core.py disagree about the version")



# --- argparse ----------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="compass",
        description="The Compass CLI - the deterministic half of an adaptive "
                    "framework. Judgement produces the readings; this applies "
                    "the policy and runs the checks.",
    )
    p.add_argument("--version", action="version",
                   version=f"compass {COMPASS_VERSION} "
                           f"(task schema {COMPASS_SCHEMA_VERSION})")
    sub = p.add_subparsers(dest="cmd", required=True)

    pr = sub.add_parser("route", help="routing")
    prs = pr.add_subparsers(dest="subcmd", required=True)
    pre = prs.add_parser("evaluate", help="apply routing-policy.yml to a task's readings")
    pre.add_argument("--task", help="task slug (default: current-task pointer)")
    pre.add_argument("--reading", action="append",
                     help="ad-hoc reading key=value (repeatable; touches=a,b,c)")
    pre.add_argument("--write", action="store_true",
                     help="fold route/phases/gates back into the task's task.yml")
    pre.add_argument("--reason",
                     help="when --write detects a re-frame (the route changed), "
                          "record this as the reason - it is the calibration signal")
    pre.add_argument("--json", action="store_true", help="emit JSON")
    pre.set_defaults(func=cmd_route_evaluate)

    # `bdd` is a subcommand GROUP, not a flat verb, so later BDD work (a
    # scenarios-are-executable check) adds `compass bdd <thing>` rather than a
    # second top-level verb.
    pb = sub.add_parser("bdd", help="executable-BDD tools")
    pbs = pb.add_subparsers(dest="subcmd", required=True)
    pbe = pbs.add_parser(
        "extract",
        help="extract a task's spec.feature.md into a runnable .feature file")
    pbe.add_argument("--task", help="task slug (default: current-task pointer)")
    pbe.add_argument("--out", help="write here instead of the resolved default")
    pbe.set_defaults(func=cmd_bdd_extract)

    pbv = pbs.add_parser(
        "verify",
        help="run the project's BDD suite and record which scenarios it reported")
    pbv.add_argument("--task", help="task slug (default: current-task pointer)")
    pbv.add_argument("command", nargs=argparse.REMAINDER,
                     help="the run command, after `--`")
    pbv.set_defaults(func=cmd_bdd_verify)

    pc = sub.add_parser("check", help="run the guardrails.yml checks against a task")
    pc.add_argument("--task", help="task slug (default: current-task pointer)")
    pc.set_defaults(func=cmd_check)

    pan = sub.add_parser(
        "analyze",
        help="cross-artifact coherence check - orphaned scenarios, route "
             "disagreements, and orphan claims (advisory or gate-clearing "
             "depending on whether verify.analyze is in the task's gate set)",
    )
    pan.add_argument("--task", help="task slug (default: current-task pointer)")
    pan.set_defaults(func=cmd_analyze)

    pcal = sub.add_parser("calibration",
                          help="the Needle's feedback loop - re-frame patterns "
                               "across all tasks (is routing well-sized?)")
    pcal.add_argument(
        "--impact", action="store_true",
        help="process-impact signal: lead time, land frequency, change-fail and "
             "restore time, attributed to route and gate set (advisory)")
    pcal.add_argument(
        "--friction",
        action="store_true",
        help="aggregate the per-task `friction:` signal instead of reframes - "
             "recurring process friction grouped by category and proposed "
             "change (advisory only; exit 0 always)",
    )
    pcal.add_argument(
        "--format",
        choices=["markdown", "json"],
        default="markdown",
        help="output format for --friction (default: markdown)",
    )
    pcal.set_defaults(func=cmd_calibration)

    pci = sub.add_parser("ci",
                         help="run the full mechanical gate suite (policy lint "
                              "+ task lint + check, all tasks) - for CI")
    pci.set_defaults(func=cmd_ci)

    prd = sub.add_parser("tdd-red", help="run a test, assert it FAILS, record the red")
    prd.add_argument("--task", help="task slug (default: current-task pointer)")
    prd.add_argument("--scenario", help="scenario id this red is evidence FOR "
                     "(e.g. SCN-001) - binds the failure to a scenario, so it "
                     "proves relevance, not just that something failed")
    prd.add_argument("--verified-by", dest="verified_by",
                     help="sanction a non-unit red for a change with no natural "
                          "unit test: regression | e2e | typecheck | live (R8). "
                          "The guard must still genuinely fail first.")
    prd.add_argument("command", nargs=argparse.REMAINDER,
                     help="the test command (after --)")
    prd.set_defaults(func=cmd_tdd_red)

    pg = sub.add_parser("tdd-green", help="run a test, assert it PASSES, record the green")
    pg.add_argument("--task", help="task slug (default: current-task pointer)")
    pg.add_argument("--scenario", help="scenario id this green is evidence FOR "
                    "(e.g. SCN-001)")
    pg.add_argument("--verified-by", dest="verified_by",
                    help="carry forward a verified-by guard kind (regression | "
                         "e2e | typecheck | live) - the green re-runs the guard "
                         "that stood in for a unit red (R8)")
    pg.add_argument("command", nargs=argparse.REMAINDER,
                    help="the test command (after --)")
    pg.set_defaults(func=cmd_tdd_green)

    pl = sub.add_parser("policy", help="governance policy tools")
    pls = pl.add_subparsers(dest="subcmd", required=True)
    pll = pls.add_parser("lint", help="structurally validate the governance YAML")
    pll.set_defaults(func=cmd_policy_lint)

    ppl = sub.add_parser("plan", help="plan.md tools")
    ppls = ppl.add_subparsers(dest="subcmd", required=True)
    ppll = ppls.add_parser(
        "lint", help="scan a plan.md for placeholder phrases (advisory; always exits 0)")
    ppll.add_argument("--task", help="task slug (default: current-task pointer)")
    ppll.add_argument("--file", help="lint a specific plan.md file")
    ppll.set_defaults(func=cmd_plan_lint)

    pt = sub.add_parser("task", help="task manifest tools")
    pts = pt.add_subparsers(dest="subcmd", required=True)
    ptl = pts.add_parser("lint", help="structurally validate a task.yml")
    ptl.add_argument("--task", help="task slug (default: current-task pointer)")
    ptl.add_argument("--file", help="lint a specific task.yml file")
    ptl.set_defaults(func=cmd_task_lint)

    ptr = pts.add_parser("receipt", help="render a one-screen receipt for a task")
    ptr.add_argument("--task", help="task slug (default: current-task pointer)")
    ptr.add_argument("--workdir", help="alternate project root (default: cwd)")
    ptr.set_defaults(func=cmd_task_receipt)

    padr = sub.add_parser("adr", help="Architecture Decision Record tools")
    padrs = padr.add_subparsers(dest="subcmd", required=True)
    padrn = padrs.add_parser(
        "new",
        help="create a new numbered ADR file in architecture/decisions/",
    )
    padrn.add_argument(
        "slug",
        help="short kebab-case slug for the ADR (e.g. 'use-postgres')",
    )
    padrn.set_defaults(func=cmd_adr_new)

    prs2 = sub.add_parser(
        "rework-scan",
        help="cross-task rework scanner - detect add-then-delete patterns "
             "across tasks (signal only; exit 0 on detection)",
    )
    prs2.add_argument(
        "--root",
        default=None,
        help="root directory to scan for task.yml files "
             "(default: .compass/work/ in the current project)",
    )
    prs2.add_argument(
        "--window-days",
        type=int,
        default=None,
        dest="window_days",
        help="override the window_days from signals.yml",
    )
    prs2.add_argument(
        "--format",
        choices=["markdown", "json"],
        default="markdown",
        help="output format (default: markdown)",
    )
    prs2.set_defaults(func=cmd_rework_scan)

    pfl = sub.add_parser(
        "flow",
        help="cross-task flow view - status board and optional digest "
             "(advisory only; never modifies task state)",
    )
    pfl.add_argument(
        "--digest",
        action="store_true",
        help="write a dated digest to stdout including the rework-scan "
             "section and calibration signal (Inv-4: advisory only)",
    )
    pfl.add_argument(
        "--work-root",
        default=None,
        dest="work_root",
        help="root directory containing task subdirectories "
             "(default: .compass/work/ in the current project)",
    )
    pfl.set_defaults(func=cmd_flow)

    pnx = sub.add_parser(
        "next",
        help="what comes next on this task's route? (read-only; one line)",
    )
    pnx.add_argument("--task", help="task slug (default: current-task pointer)")
    pnx.set_defaults(func=cmd_next)

    pbf = sub.add_parser(
        "backfill",
        help="manage task backfills (owed / paid ceremony)"
    )
    pbfs = pbf.add_subparsers(dest="subcmd", required=True)
    pbfp = pbfs.add_parser(
        "pay",
        help="mark a backfill as paid in a task's task.yml"
    )
    pbfp.add_argument(
        "--task", required=True,
        help="task slug whose backfill is being paid"
    )
    pbfp.add_argument(
        "backfill_id",
        help="the backfill id to mark paid (e.g. BF-1)"
    )
    pbfp.set_defaults(func=cmd_backfill_pay)

    plc = sub.add_parser(
        "land-commit",
        help="commit staged artifacts robustly - survives auto-fixing "
             "pre-commit hooks and verifies HEAD advanced (R5)",
    )
    plc.add_argument("-m", "--message", required=True, help="commit message")
    plc.add_argument("--task", help="task slug to mark landed on a verified commit")
    plc.add_argument("files", nargs="*",
                     help="optional paths to stage before committing")
    plc.set_defaults(func=cmd_land_commit)

    # --- task-spine mutators (R9) + gate pass (R6) --------------------------
    pgate = sub.add_parser("gate", help="task gate tools")
    pgs = pgate.add_subparsers(dest="subcmd", required=True)
    pgp = pgs.add_parser(
        "pass", help="mark a gate pass, validating evidence type at write time")
    pgp.add_argument("gate_id", help="gate id (e.g. verify.correctness)")
    pgp.add_argument("--task", help="task slug (default: current-task pointer)")
    pgp.add_argument("--evidence", action="append",
                     help="evidence id backing this gate (repeatable)")
    pgp.set_defaults(func=cmd_gate_pass)

    pscn = sub.add_parser("scenario", help="task scenario tools")
    pscs = pscn.add_subparsers(dest="subcmd", required=True)
    psca = pscs.add_parser("add", help="append a scenario to task.yml")
    psca.add_argument("scenario_id", help="scenario id (e.g. SCN-001)")
    psca.add_argument("--task", help="task slug (default: current-task pointer)")
    psca.add_argument("--title", help="scenario title")
    psca.add_argument("--intent", required=True, help="linked intent id")
    psca.add_argument("--test", action="append",
                      help="test that exercises it (repeatable)")
    psca.set_defaults(func=cmd_scenario_add)

    pcf = sub.add_parser("changed-file", help="task changed-file tools")
    pcfs = pcf.add_subparsers(dest="subcmd", required=True)
    pcfa = pcfs.add_parser("add", help="trace a changed production file to a scenario")
    pcfa.add_argument("path", help="production file path")
    pcfa.add_argument("--task", help="task slug (default: current-task pointer)")
    pcfa.add_argument("--scenario", required=True, help="scenario id it traces to")
    pcfa.set_defaults(func=cmd_changed_file_add)

    pev = sub.add_parser("evidence", help="task evidence-registry tools")
    pevs = pev.add_subparsers(dest="subcmd", required=True)
    peva = pevs.add_parser("add", help="append a typed evidence entry")
    peva.add_argument("evidence_id", help="evidence id (e.g. EV-5)")
    peva.add_argument("--task", help="task slug (default: current-task pointer)")
    peva.add_argument("--type", required=True, help="evidence type (see guardrails.yml)")
    peva.add_argument("--path", required=True, help="path to the evidence file")
    peva.add_argument("--scenario", help="scenario this evidence is for (optional)")
    peva.set_defaults(func=cmd_evidence_add)

    # --- private entry point (DD-4, TRC-B6) ---------------------------------
    # The leading underscore in the name is the convention that marks a
    # subcommand as private (in-framework callers only).
    # We register it via add_parser(help=SUPPRESS) to hide it from the
    # subcommand help listing, and then manually remove it from the
    # _choices_actions list so it also disappears from the usage line and the
    # {choices} display.  This keeps the public surface at exactly the verbs
    # TRC-D2 tests for.
    p_derive = sub.add_parser(
        "_derive-system-spec",
        help=argparse.SUPPRESS,
    )
    p_derive.add_argument(
        "--internal",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    p_derive.set_defaults(func=cmd_derive_system_spec)

    # Private entry point for the Land friction-capture step (DD-3). Hidden the
    # same way as _derive-system-spec; called by commands/land.md, not a public
    # verb (PRD Goal 4 - deepen, don't widen the surface).
    p_fric = sub.add_parser("_friction-capture", help=argparse.SUPPRESS)
    p_fric.add_argument("--internal", action="store_true", help=argparse.SUPPRESS)
    p_fric.add_argument("--task", help=argparse.SUPPRESS)
    p_fric.add_argument("--note", help=argparse.SUPPRESS)
    p_fric.add_argument("--note-category", dest="note_category",
                        help=argparse.SUPPRESS)
    p_fric.add_argument("--note-phase", dest="note_phase", help=argparse.SUPPRESS)
    p_fric.set_defaults(func=cmd_friction_capture)
    # Hide all private (leading-underscore) subcommands from --help output:
    #   1. Remove from _choices_actions  →  hides from the positional-args
    #      listing section in the help text.
    #   2. Override metavar on the subparsers action  →  hides from the
    #      usage line (which uses the metavar string for display).
    # The parsers remain in sub.choices/_name_parser_map so they can still
    # be invoked; they just do not surface in the public help surface.
    # TRC-D2 checks the *public* subcommand list after landing; this is the
    # mechanism that keeps the count at two new public verbs (analyze, next).
    sub._choices_actions = [
        a for a in sub._choices_actions
        if not a.dest.startswith("_")
    ]
    public_names = [k for k in sub.choices if not k.startswith("_")]
    sub.metavar = "{" + ",".join(public_names) + "}"

    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    # tdd-red/green: strip a leading "--" that argparse REMAINDER keeps
    if getattr(args, "command", None) and args.command and args.command[0] == "--":
        args.command = args.command[1:]
    try:
        return args.func(args) or 0
    except CompassError as exc:
        sys.stderr.write(f"compass: {exc}\n")
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
